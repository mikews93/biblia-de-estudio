{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run data && npm run comentarios && npx expo export --platform web && python3 pipeline/seo_pages.py dist",
  "outputDirectory": "dist",
  "ignoreCommand": "sh pipeline/vercel_ignorar.sh",
  "functions": {
    "api/estudiar.ts": {
      "includeFiles": "dist/data/{books.json,text/rv1909/**,interlinear/**,xrefs/**,concordance/**}",
      "maxDuration": 120,
      "excludeFiles": "dist/**"
    },
    "api/comunidades.ts": {
      "includeFiles": "dist/data/{books.json,versions.json,text/**}",
      "maxDuration": 60,
      "excludeFiles": "dist/**"
    },
    "api/audio.ts": {
      "maxDuration": 30
    },
    "api/biblia.ts": {
      "maxDuration": 30
    },
    "api/buscar.ts": {
      "includeFiles": "dist/data/{books.json,text/rv1909/**}",
      "maxDuration": 60,
      "excludeFiles": "dist/**"
    },
    "api/comentario.ts": {
      "includeFiles": "{dist/data/books.json,dist/data/text/rv1909/**,comentarios-licencia/**}",
      "maxDuration": 120,
      "excludeFiles": "dist/**"
    },
    "api/podcast-grabado.ts": {
      "maxDuration": 300
    },
    "api/notificaciones.ts": {
      "maxDuration": 60
    },
    "api/facebook.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|data/|_expo/|assets/|audio/).*)",
      "destination": "/app.html"
    }
  ]
}
