{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run data && npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/estudiar.ts": { "includeFiles": "dist/data/**", "maxDuration": 120 },
    "api/comunidades.ts": { "includeFiles": "dist/data/**", "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/((?!api/|data/|_expo/|assets/).*)", "destination": "/index.html" }]
}
