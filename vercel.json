{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "export ZARZA_FECHA_COMPILACION=$(date -u +%Y-%m-%dT%H:%M:%SZ) && npm run data && npm run semantica && npm run comentarios && npm run teologia && npx expo export --platform web && python3 pipeline/seo_pages.py dist && node pipeline/version_web.mjs dist",
  "outputDirectory": "dist",
  "ignoreCommand": "sh pipeline/vercel_ignorar.sh",
  "functions": {
    "api/estudiar.ts": {
      "includeFiles": "dist/data/{books.json,versions.json,text/rv1909/**,interlinear/**,xrefs/**,concordance/**,palabras/**}",
      "maxDuration": 300,
      "excludeFiles": "dist/**"
    },
    "api/comunidades.ts": {
      "includeFiles": "dist/data/{books.json,versions.json,text/**}",
      "maxDuration": 60,
      "excludeFiles": "dist/**"
    },
    "api/audio.ts": {
      "maxDuration": 30
    },
    "api/biblia.ts": {
      "maxDuration": 30
    },
    "api/buscar.ts": {
      "includeFiles": "{dist/data/{books.json,versions.json,text/rv1909/**,semantica/**},node_modules/onnxruntime-node/bin/napi-v6/linux/x64/{onnxruntime_binding.node,libonnxruntime.so.1,libonnxruntime_providers_shared.so}}",
      "maxDuration": 60,
      "excludeFiles": "{dist/**,node_modules/onnxruntime-web/**,node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32,linux/arm64}/**,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_{cuda,tensorrt}.so,node_modules/@img/sharp-wasm32/**}"
    },
    "api/comentario.ts": {
      "includeFiles": "{dist/data/books.json,dist/data/text/rv1909/**,comentarios-licencia/**}",
      "maxDuration": 120,
      "excludeFiles": "dist/**"
    },
    "api/podcast-grabado.ts": {
      "maxDuration": 300
    },
    "api/notificaciones.ts": {
      "maxDuration": 60
    },
    "api/auth.ts": {
      "maxDuration": 30
    },
    "api/vivo.ts": {
      "includeFiles": "dist/data/books.json",
      "maxDuration": 15,
      "excludeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?ruta=$1"
    },
    {
      "source": "/((?!api/|data/|_expo/|assets/|audio/).*)",
      "destination": "/app.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/project-thread-u5ttns": false
    }
  }
}
